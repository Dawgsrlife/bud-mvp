{
  "expo": {
    "name": "BUD",
    "slug": "bud-mvp",
    "version": "0.1.0",
    "scheme": "bud",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FAFAFA"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "io.zedsio.bud",
      "infoPlist": {
        "NSCameraUsageDescription": "BUD uses your camera to scan grocery product labels.",
        "NSPhotoLibraryUsageDescription": "BUD reads images from your photo library to scan product labels."
      }
    },
    "android": {
      "package": "io.zedsio.bud",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FAFAFA"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": true,
      "permissions": ["android.permission.CAMERA"]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    }
  }
}
